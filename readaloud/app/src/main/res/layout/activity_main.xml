<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Links or text, read aloud by a neural voice on your phone."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Model download (shown until the selected model is installed) -->
        <LinearLayout
            android:id="@+id/modelCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                android:id="@+id/modelTitle"
                style="@style/CardTitle"
                android:text="Download the voice model" />

            <TextView
                android:id="@+id/modelInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/modelProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="100"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/modelDownload"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Download" />

                <Button
                    android:id="@+id/modelCancel"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Cancel"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Link -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="Link" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/urlInput"
                    style="@style/Field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="Paste an article, blog or PDF link"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/fetchButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Fetch" />
            </LinearLayout>

            <TextView
                android:id="@+id/fetchStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Text -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Text" />

                <TextView
                    android:id="@+id/charCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/clearButton"
                    style="@android:style/Widget.Material.Button.Borderless.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="Clear"
                    android:textAllCaps="false" />
            </LinearLayout>

            <EditText
                android:id="@+id/textInput"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:gravity="top|start"
                android:hint="…or paste or type the text to read"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="14"
                android:minLines="7"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- Voice -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="Voice" />

            <Spinner
                android:id="@+id/engineSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp" />

            <Spinner
                android:id="@+id/voiceSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/speedBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="30" />

                <TextView
                    android:id="@+id/speedLabel"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Player -->
        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/playStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/playProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/nowReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="4"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:textStyle="italic"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Read aloud" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:enabled="false"
                    android:text="Stop" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Save as audio file" />

                <Button
                    android:id="@+id/shareButton"
                    style="@style/SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Share"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Speech is generated on-device with sherpa-onnx.\nKokoro-82M (Apache-2.0) · Supertonic 3 (OpenRAIL-M)"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
